# Supabase (public, read-only via RLS). Required.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional. CTA Bus Tracker API key for GET /arrivals. Without it the route returns {available:false}.
CTA_BUS_KEY=

# Optional. User-Agent sent to Nominatim (OSM policy asks for an identifying UA).
NOMINATIM_USER_AGENT=

# Optional. Override the Transitous base URL for GET /route (default https://api.transitous.org).
TRANSITOUS_BASE_URL=

# Optional, local dev only. Port for `npm run dev` (default 3000).
PORT=
