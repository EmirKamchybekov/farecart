// Farecart Debug configuration.
// These values are copied into Info.plist (see project.yml) and read by AppConfig at launch.
// Only the anon/publishable Supabase key belongs here. NEVER put the service role key in ios/.
//
// xcconfig treats "//" as a comment, so URLs are written as "https:/$()/host".

SUPABASE_URL = https:/$()/mwirkxfqbomaaoygyfgm.supabase.co
SUPABASE_ANON_KEY = sb_publishable_L9LttUWfO7RRu0m3PFF0zA_nkb7L_fu

// Optional Farecart API (api/ on Vercel) used for geocoding: GET {API_BASE_URL}/geocode?q=...
// Leave empty to use Apple's MapKit geocoder only; the app works standalone.
API_BASE_URL =

// Where "Report a problem with a listing" emails go.
REPORT_PROBLEM_EMAIL = hello@farecart.org
