    "%@ with your %@ discount (instead of %@)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ مع خصم %2$@ (بدلًا من %3$@)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ con tu descuento %2$@ (en vez de %3$@)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gamit ang diskuwento ng %2$@ (sa halip na %3$@)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 할인 적용 시 %1$@ (정상 요금 %3$@)"
          }
        },
        "pl": {
