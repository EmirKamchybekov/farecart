{
  "sourceLanguage": "en",
  "strings": {
    "%@ Your phone keeps a confirmation code; no name, email or account is needed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Tu teléfono guarda un código de confirmación; no hace falta nombre, correo ni cuenta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Twój telefon zachowa kod potwierdzenia; nie trzeba podawać imienia, e-maila ani zakładać konta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 您的手机会保存确认码；无需姓名、邮箱或账户。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يحتفظ هاتفك برمز التأكيد؛ لا حاجة إلى اسم أو بريد إلكتروني أو حساب."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Itatago ng iyong telepono ang confirmation code; hindi kailangan ng pangalan, email o account."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ آپ کا فون تصدیقی کوڈ محفوظ رکھتا ہے؛ نام، ای میل یا اکاؤنٹ کی ضرورت نہیں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ваш телефон зберігає код підтвердження; ім’я, електронна пошта чи обліковий запис не потрібні."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 확인 코드는 휴대폰에 저장됩니다. 이름, 이메일, 계정은 필요 없습니다."
          }
        }
      }
    },
    "%@ away": {
