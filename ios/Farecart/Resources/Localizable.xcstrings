          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حاجة هنا إلى SNAP أو هوية."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi kailangan dito ng SNAP o ID."
          }
        },
