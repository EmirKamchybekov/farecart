    "Arrived": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصل"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegó"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dumating"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도착"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przybył/a"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прибув/ла"
          }
        },
