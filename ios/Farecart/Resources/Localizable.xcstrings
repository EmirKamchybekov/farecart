          }
        }
      }
    },
    "That time just filled up. Pick another one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese horario se acaba de llenar. Elige otro."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten termin właśnie się zapełnił. Wybierz inny."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该时段刚刚约满。请选择其他时段。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امتلأ هذا الوقت للتو. اختر وقتًا آخر."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapupuno lang ng oras na iyon. Pumili ng iba."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ وقت ابھی بھر گیا۔ کوئی اور منتخب کریں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей час щойно заповнився. Оберіть інший."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 마감되었습니다. 다른 시간을 선택하세요."
          }
        }
      }
    },
    "The Discounts tab shows how to sign up.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pestaña Descuentos muestra cómo inscribirte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakładka Zniżki pokazuje, jak się zapisać."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“优惠”标签会显示如何申请。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض تبويب الخصومات كيفية التسجيل."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita ng tab na Mga Diskuwento kung paano mag-sign up."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رعایتیں ٹیب سائن اپ کا طریقہ دکھاتا ہے۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладка «Знижки» показує, як оформити."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "할인 탭에서 신청 방법을 볼 수 있어요."
          }
        }
      }
    },
    "The end time must be after the start time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de fin debe ser posterior a la de inicio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godzina zakończenia musi być późniejsza niż rozpoczęcia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束时间必须晚于开始时间。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون وقت الانتهاء بعد وقت البدء."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapat mas huli ang oras ng pagtatapos kaysa sa oras ng simula."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اختتام کا وقت شروع کے وقت کے بعد ہونا چاہیے۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час завершення має бути після часу початку."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시간은 시작 시간 이후여야 합니다."
          }
        }
      }
    },
    "This code is no longer valid.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este código ya no es válido."
