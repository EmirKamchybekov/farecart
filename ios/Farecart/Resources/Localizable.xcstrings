    "No CTA route found for this trip right now.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على مسار CTA لهذه الرحلة الآن."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró una ruta de la CTA para este viaje ahora mismo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nahanap na ruta ng CTA para sa biyaheng ito ngayon."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 이 여정의 CTA 경로를 찾지 못했어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
