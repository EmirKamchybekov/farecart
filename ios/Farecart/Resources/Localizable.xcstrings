    "You already have a visit booked for that time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya tienes una visita reservada a esa hora."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz już rezerwację na tę godzinę."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已预约该时段。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك زيارة محجوزة بالفعل في هذا الوقت."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May naka-book ka nang pagbisita sa oras na iyon."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا اس وقت کے لیے پہلے ہی دورہ بک ہے۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас уже є візит на цей час."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 이 시간에 예약된 방문이 있습니다."
          }
        }
      }
    },
    "You could pay %@ instead of %@ per bus ride.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrías pagar %1$@ en vez de %2$@ por viaje en autobús."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za przejazd autobusem możesz płacić %1$@ zamiast %2$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次乘公交您只需支付 %1$@，而不是 %2$@。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك دفع %1$@ بدلًا من %2$@ لكل رحلة حافلة."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwede kang magbayad ng %1$@ sa halip na %2$@ bawat sakay sa bus."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ فی بس سواری %2$@ کی بجائے %1$@ ادا کر سکتے ہیں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви могли б платити %1$@ замість %2$@ за поїздку автобусом."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버스 1회당 %2$@ 대신 %1$@만 내면 됩니다."
          }
        }
      }
    },
