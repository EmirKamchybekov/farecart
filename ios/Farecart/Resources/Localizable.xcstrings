            "value": "已到达"
          }
        }
      }
    },
    "Ask for the code when someone arrives, then tap Arrived.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب الرمز عند وصول أي شخص، ثم اضغط على «وصل»."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide el código cuando alguien llegue y luego toca Llegó."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingin ang code kapag may dumating, pagkatapos ay i-tap ang Dumating."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방문자가 도착하면 코드를 확인한 뒤 ‘도착’을 누르세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy ktoś przyjdzie, poproś o kod i stuknij Przybył/a."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли хтось прийде, запитайте код і натисніть «Прибув/ла»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب کوئی پہنچے تو کوڈ پوچھیں، پھر «پہنچ گئے» پر ٹیپ کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人到达时请询问确认码，然后点按“已到达”。"
          }
        }
      }
    },
    "Ask your pantry coordinator for the 6-character code. It lets you post today's stock, open visit slots and check people in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من منسّق المخزن الرمز المكوّن من 6 أحرف. يتيح لك نشر مخزون اليوم وفتح مواعيد الزيارة وتسجيل وصول الناس."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a la persona coordinadora de la despensa el código de 6 caracteres. Te permite publicar el inventario de hoy, abrir horarios de visita y registrar llegadas."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hingin sa coordinator ng pantry ang 6-character na code. Hinahayaan ka nitong mag-post ng stock ngayon, magbukas ng mga slot ng pagbisita at mag-check in ng mga tao."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팬트리 담당자에게 6자리 코드를 받으세요. 이 코드로 오늘의 재고를 게시하고, 방문 시간대를 열고, 방문자를 체크인할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poproś koordynatora jadłodajni o 6-znakowy kod. Pozwala on publikować dzisiejsze zapasy, otwierać terminy wizyt i odhaczać przybyłych."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитайте у координатора продуктового банку 6-значний код. Він дає змогу публікувати сьогоднішні запаси, відкривати слоти для візитів і відмічати прибулих."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے پینٹری کوآرڈینیٹر سے 6 حرفی کوڈ لیں۔ اس سے آپ آج کا اسٹاک پوسٹ کر سکتے ہیں، دورے کے سلاٹ کھول سکتے ہیں اور لوگوں کی آمد درج کر سکتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请向食品站负责人索取 6 位代码。它可用于发布今日库存、开放预约时段并为到访者签到。"
          }
        }
      }
    },
    "At least 8 characters.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "8 أحرف على الأقل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos 8 caracteres."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi bababa sa 8 character."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "8자 이상."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co najmniej 8 znaków."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щонайменше 8 символів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کم از کم 8 حروف۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 8 个字符。"
          }
        }
      }
    },
