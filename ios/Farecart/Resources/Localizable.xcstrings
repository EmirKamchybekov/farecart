          }
        }
      }
    },
    "Count everyone picking up food with you, up to 6. The pantry uses this to plan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احسب كل من سيستلم الطعام معك، حتى 6 أشخاص. يستخدم المخزن هذا للتخطيط."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta a todas las personas que recogerán comida contigo, hasta 6. La despensa lo usa para planificar."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilangin ang lahat ng kukuha ng pagkain kasama mo, hanggang 6. Ginagamit ito ng pantry para magplano."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "함께 음식을 받을 인원을 모두 세어 주세요(최대 6명). 팬트리가 준비에 참고합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Policz wszystkich, którzy odbiorą jedzenie razem z Tobą, maksymalnie 6 osób. Jadłodajnia używa tego do planowania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Порахуйте всіх, хто отримуватиме їжу разом з вами, до 6 осіб. Продуктовий банк використовує це для планування."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے ساتھ کھانا لینے والے سب کو شمار کریں، زیادہ سے زیادہ 6۔ پینٹری اسے منصوبہ بندی کے لیے استعمال کرتی ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请计入与您一同领取食物的所有人（最多 6 人）。食品站据此做准备。"
          }
        }
      }
    },
