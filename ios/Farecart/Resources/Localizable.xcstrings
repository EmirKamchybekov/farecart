        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wizyta została już odhaczona."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次到访已签到。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل وصول هذه الزيارة بالفعل."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-check in na ang pagbisitang ito."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس دورے کی آمد پہلے ہی درج ہو چکی ہے۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей візит уже відмічено."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 방문은 이미 체크인되었습니다."
          }
        }
      }
    },
    "This visit was cancelled.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta visita fue cancelada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wizyta została anulowana."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此次预约已取消。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء هذه الزيارة."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinansela ang pagbisitang ito."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ دورہ منسوخ ہو گیا تھا۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей візит було скасовано."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 방문은 취소되었습니다."
          }
        }
      }
    },
    "To delete your account and its data, email %@ from the address you signed in with. In-app deletion is coming soon.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para eliminar tu cuenta y sus datos, escribe a %@ desde el correo con el que iniciaste sesión. Pronto podrás eliminarla desde la app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby usunąć konto i jego dane, napisz na %@ z adresu, którym się logujesz. Usuwanie w aplikacji pojawi się wkrótce."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如需删除您的账户及其数据，请使用登录时的邮箱发邮件至 %@。应用内删除功能即将推出。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لحذف حسابك وبياناته، راسل %@ من البريد الذي سجّلت الدخول به. الحذف من داخل التطبيق قادم قريبًا."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Para burahin ang account mo at ang datos nito, mag-email sa %@ mula sa address na ginamit mo sa pag-sign in. Malapit nang dumating ang pagbura sa loob ng app."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا اکاؤنٹ اور اس کا ڈیٹا حذف کرنے کے لیے، جس ای میل سے سائن ان کیا اسی سے %@ پر ای میل کریں۔ ایپ کے اندر حذف کرنے کی سہولت جلد آ رہی ہے۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб видалити обліковий запис і його дані, напишіть на %@ з адреси, з якою ви ввійшли. Видалення в застосунку з'явиться незабаром."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정과 데이터를 삭제하려면 로그인에 사용한 이메일로 %@에 메일을 보내 주세요. 앱 내 삭제 기능은 곧 제공됩니다."
          }
        }
      }
    },
