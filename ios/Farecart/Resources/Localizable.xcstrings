    "Something went wrong on our side. Please try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal de nuestro lado. Inténtalo de nuevo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Coś poszło nie tak po naszej stronie. Spróbuj ponownie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们这边出了点问题。请重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ من جانبنا. حاول مرة أخرى."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May nangyaring mali sa aming panig. Pakisubukang muli."
          }
