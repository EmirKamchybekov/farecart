    "No CTA route found for this trip right now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró una ruta de la CTA para este viaje ahora mismo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono teraz trasy CTA dla tej podróży."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前未找到此行程的 CTA 路线。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على مسار CTA لهذه الرحلة الآن."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nahanap na ruta ng CTA para sa biyaheng ito ngayon."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سفر کے لیے ابھی کوئی CTA راستہ نہیں ملا۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз не знайдено маршруту CTA для цієї поїздки."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 이 여정의 CTA 경로를 찾지 못했어요."
          }
        }
      }
    },
