    "Visits you booked stay on this phone with their codes, but are no longer linked to an account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الزيارات التي حجزتها على هذا الهاتف مع رموزها، لكنها لن تكون مرتبطة بحساب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las visitas que reservaste se quedan en este teléfono con sus códigos, pero ya no están vinculadas a una cuenta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mananatili sa teleponong ito ang mga na-book mong pagbisita kasama ang mga code, pero hindi na naka-link sa account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약한 방문은 코드와 함께 이 휴대폰에 남지만 더 이상 계정에 연결되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarezerwowane wizyty zostają na tym telefonie z kodami, ale nie są już powiązane z kontem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заброньовані візити залишаться на цьому телефоні з кодами, але більше не будуть прив'язані до облікового запису."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے بک کیے گئے وزٹس اپنے کوڈز کے ساتھ اس فون پر رہیں گے، لیکن کسی اکاؤنٹ سے منسلک نہیں ہوں گے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你预约的到访会连同确认码保留在这部手机上，但不再与账户关联。"
          }
        }
      }
    },
