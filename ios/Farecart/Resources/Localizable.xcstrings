    "Your visits, discount answers, language and theme are saved to your account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ زياراتك وإجاباتك عن الخصومات ولغتك ومظهرك في حسابك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus visitas, respuestas sobre descuentos, idioma y tema se guardan en tu cuenta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-save sa iyong account ang iyong mga pagbisita, sagot sa diskwento, wika at tema."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방문, 할인 답변, 언어, 테마가 계정에 저장됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje wizyty, odpowiedzi o zniżkach, język i motyw są zapisywane na koncie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші візити, відповіді щодо знижок, мова й тема зберігаються в обліковому записі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے وزٹس، رعایت کے جوابات، زبان اور تھیم آپ کے اکاؤنٹ میں محفوظ ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的到访预约、优惠回答、语言和主题都会保存到你的账户。"
          }
        }
      }
    },
