    "Two quick questions. Your answers are saved to your account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سؤالان سريعان. تُحفظ إجاباتك في حسابك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dos preguntas rápidas. Tus respuestas se guardan en tu cuenta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalawang mabilis na tanong. Naka-save sa iyong account ang mga sagot mo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "간단한 질문 두 가지입니다. 답변은 계정에 저장됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dwa krótkie pytania. Twoje odpowiedzi zostaną zapisane na koncie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Два швидкі запитання. Ваші відповіді зберігаються в обліковому записі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دو مختصر سوال۔ آپ کے جوابات آپ کے اکاؤنٹ میں محفوظ ہوتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两个简单问题。你的回答会保存到你的账户。"
          }
        }
      }
    },
