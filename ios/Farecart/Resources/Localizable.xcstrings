          "stringUnit": {
            "state": "translated",
            "value": "此邮箱已有账户。请直接登录。"
          }
        }
      }
    },
    "This can't be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن ذلك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi na ito maibabalik."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 되돌릴 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tej operacji nie można cofnąć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це не можна скасувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے واپس نہیں کیا جا سکتا۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。"
          }
        }
      }
    },
    "This can't be undone. You can make a new account later.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التراجع عن ذلك. يمكنك إنشاء حساب جديد لاحقًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer. Puedes crear una cuenta nueva más tarde."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi na ito maibabalik. Puwede kang gumawa ng bagong account mamaya."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 되돌릴 수 없습니다. 나중에 새 계정을 만들 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tej operacji nie można cofnąć. Później możesz założyć nowe konto."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
