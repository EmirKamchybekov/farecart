    "Google sign-in did not finish. Please try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se completó el inicio de sesión con Google. Inténtalo de nuevo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie przez Google nie zostało ukończone. Spróbuj ponownie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Google 登录未完成。请重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل تسجيل الدخول بـ Google. يُرجى المحاولة مرة أخرى."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi natapos ang pag-sign in gamit ang Google. Pakisubukan ulit."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Google سے سائن ان مکمل نہیں ہوا۔ براہ کرم دوبارہ کوشش کریں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід через Google не завершено. Спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google로 로그인이 완료되지 않았어요. 다시 시도해 주세요."
          }
        }
      }
    },
    "Google sign-in isn't set up yet. You can keep using Farecart without an account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión con Google aún no está configurado. Puedes seguir usando Farecart sin cuenta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie przez Google nie jest jeszcze skonfigurowane. Możesz dalej używać Farecart bez konta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 登录尚未设置。您可以继续在没有账户的情况下使用 Farecart。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول بـ Google غير مُعدّ بعد. يمكنك متابعة استخدام Farecart بدون حساب."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa naka-set up ang pag-sign in gamit ang Google. Puwede mong patuloy na gamitin ang Farecart nang walang account."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Google سے سائن ان ابھی سیٹ اپ نہیں ہوا۔ آپ اکاؤنٹ کے بغیر Farecart استعمال کرتے رہ سکتے ہیں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід через Google ще не налаштовано. Ви можете й далі користуватися Farecart без облікового запису."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Google 로그인은 아직 설정되지 않았어요. 계정 없이 Farecart를 계속 사용할 수 있습니다."
          }
        }
      }
    },
