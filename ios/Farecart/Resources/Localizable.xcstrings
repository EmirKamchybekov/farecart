    "%@ away · about %lld min walk": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "a %1$@ · unos %2$lld min a pie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ stąd · około %2$lld min pieszo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离 %1$@ · 步行约 %2$lld 分钟"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على بُعد %1$@ · حوالي %2$lld دقيقة مشيًا"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ang layo · mga %2$lld min lakad"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ دور · تقریباً %2$lld منٹ پیدل"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ звідси · близько %2$lld хв пішки"
          }
