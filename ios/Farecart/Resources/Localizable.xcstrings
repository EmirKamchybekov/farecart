        }
      }
    },
    "The end time must be after the start time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون وقت الانتهاء بعد وقت البدء."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de fin debe ser posterior a la de inicio."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapat mas huli ang oras ng pagtatapos kaysa sa oras ng simula."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종료 시간은 시작 시간 이후여야 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godzina zakończenia musi być późniejsza niż rozpoczęcia."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час завершення має бути після часу початку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اختتام کا وقت شروع کے وقت کے بعد ہونا چاہیے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束时间必须晚于开始时间。"
          }
        }
      }
    },
    "There is already an account with this email. Sign in instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد حساب بهذا البريد الإلكتروني بالفعل. سجّل الدخول بدلًا من ذلك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay una cuenta con este correo. Inicia sesión."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May account na gamit ang email na ito. Mag-sign in na lang."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이메일로 된 계정이 이미 있습니다. 로그인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konto z tym adresem e-mail już istnieje. Zaloguj się."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обліковий запис із цією адресою вже існує. Увійдіть."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ای میل کے ساتھ پہلے سے اکاؤنٹ موجود ہے۔ اس کے بجائے سائن ان کریں۔"
          }
        },
