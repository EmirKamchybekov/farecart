    "Signing out only forgets the code on this phone. Stock and slots stay as posted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الخروج ينسى الرمز على هذا الهاتف فقط. يبقى المخزون والمواعيد كما نُشرت."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al salir solo se olvida el código en este teléfono. El inventario y los horarios siguen publicados."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kinakalimutan lang ng pag-sign out ang code sa teleponong ito. Mananatili ang stock at mga slot gaya ng naipost."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃하면 이 휴대폰의 코드만 지워집니다. 재고와 시간대는 그대로 유지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wylogowanie usuwa tylko kod z tego telefonu. Zapasy i terminy pozostają opublikowane."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вихід лише видаляє код з цього телефона. Запаси та слоти залишаються опублікованими."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن آؤٹ کرنے سے صرف اس فون پر کوڈ بھلا دیا جاتا ہے۔ اسٹاک اور سلاٹ ویسے ہی رہتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出只会清除本机上的代码。库存和时段保持已发布状态。"
          }
        }
      }
    },
