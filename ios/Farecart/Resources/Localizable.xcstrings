        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi available ang Sign in with Apple sa device na ito ngayon. Puwede mong patuloy na gamitin ang Farecart nang walang account."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 이 기기에서는 Apple로 로그인을 사용할 수 없어요. 계정 없이 Farecart를 계속 사용할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie przez Apple jest teraz niedostępne na tym urządzeniu. Możesz dalej używać Farecart bez konta."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід через Apple зараз недоступний на цьому пристрої. Ви можете й далі користуватися Farecart без облікового запису."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple سے سائن ان ابھی اس ڈیوائس پر دستیاب نہیں۔ آپ اکاؤنٹ کے بغیر Farecart استعمال کرتے رہ سکتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备目前无法使用“通过 Apple 登录”。您可以继续在没有账户的情况下使用 Farecart。"
          }
        }
      }
    },
