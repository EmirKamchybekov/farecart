            "state": "translated",
            "value": "확인 코드를 표시하고 취소할 수 있습니다"
          }
        }
      }
    },
    "Shows your confirmation code, directions and lets you cancel": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tu código de confirmación, las indicaciones y permite cancelar"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje kod potwierdzenia, trasę i pozwala anulować"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示您的确认码、路线并可取消"
          }
        },
        "ar": {
          "stringUnit": {
