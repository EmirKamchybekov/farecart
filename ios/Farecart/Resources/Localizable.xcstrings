      }
    },
    "Book a time at a pantry from its page in Find Food. Your confirmation codes show here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reserva un horario en una despensa desde su página en Buscar comida. Tus códigos de confirmación aparecen aquí."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarezerwuj termin w jadłodajni na jej stronie w zakładce Znajdź jedzenie. Kody potwierdzenia pojawią się tutaj."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“查找食物”中打开食品站页面即可预约时段。您的确认码会显示在这里。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احجز موعدًا في مخزن من صفحته في «ابحث عن طعام». تظهر رموز التأكيد هنا."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-book ng oras sa isang pantry mula sa pahina nito sa Maghanap ng Pagkain. Dito lalabas ang iyong mga confirmation code."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "«کھانا تلاش کریں» میں پینٹری کے صفحے سے وقت بک کریں۔ آپ کے تصدیقی کوڈ یہاں دکھائی دیں گے۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Забронюйте час у продуктовому банку на його сторінці в розділі «Знайти їжу». Ваші коди підтвердження з’являться тут."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘음식 찾기’에서 팬트리 페이지를 열어 시간을 예약하세요. 확인 코드는 여기에 표시됩니다."
          }
        }
      }
    },
    "Book a visit": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reservar visita"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarezerwuj wizytę"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预约到访"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حجز زيارة"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-book ng pagbisita"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دورہ بک کریں"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записатися на візит"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방문 예약"
          }
        }
      }
    },
    "Booking holds your spot for the time you pick. No account needed, and you can cancel any time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reserva guarda tu lugar para el horario que elijas. No necesitas cuenta y puedes cancelar cuando quieras."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezerwacja zachowuje Twoje miejsce na wybraną godzinę. Konto nie jest potrzebne, a anulować możesz w każdej chwili."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预约会为您保留所选时段的名额。无需账户，可随时取消。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظ الحجز مكانك في الوقت الذي تختاره. لا حاجة إلى حساب، ويمكنك الإلغاء في أي وقت."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniiwan ng booking ang iyong puwesto sa oras na pipiliin mo. Hindi kailangan ng account, at puwede kang magkansela anumang oras."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بکنگ آپ کے منتخب وقت کے لیے جگہ محفوظ رکھتی ہے۔ اکاؤنٹ کی ضرورت نہیں، اور آپ کسی بھی وقت منسوخ کر سکتے ہیں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бронювання зберігає ваше місце на обраний час. Обліковий запис не потрібен, і скасувати можна будь-коли."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예약하면 선택한 시간의 자리가 확보됩니다. 계정은 필요 없으며 언제든 취소할 수 있습니다."
          }
        }
      }
    },
    "Books a visit at this time": {
      "localizations": {
        "es": {
          "stringUnit": {
