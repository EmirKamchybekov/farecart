    "Signed in with Apple. Your discount answers, language and theme are saved to your account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión iniciada con Apple. Tus respuestas de descuentos, idioma y tema se guardan en tu cuenta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zalogowano przez Apple. Twoje odpowiedzi o zniżkach, język i motyw są zapisane na koncie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已通过 Apple 登录。您的优惠回答、语言和主题已保存到您的账户。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل الدخول بـ Apple. إجابات الخصومات واللغة والمظهر محفوظة في حسابك."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-sign in gamit ang Apple. Naka-save sa account mo ang mga sagot sa diskuwento, wika at tema."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple سے سائن ان ہے۔ آپ کے رعایت کے جوابات، زبان اور تھیم آپ کے اکاؤنٹ میں محفوظ ہیں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви ввійшли через Apple. Ваші відповіді про знижки, мова й тема збережені в обліковому записі."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple로 로그인되어 있습니다. 할인 답변, 언어, 화면 모드가 계정에 저장됩니다."
          }
        }
      }
    },
    "Signed in with Google. Your discount answers, language and theme are saved to your account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión iniciada con Google. Tus respuestas de descuentos, idioma y tema se guardan en tu cuenta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
