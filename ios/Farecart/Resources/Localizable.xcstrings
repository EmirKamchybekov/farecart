    "Translations other than English and Spanish are machine-assisted and under review.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الترجمات غير الإنجليزية والإسبانية أُعدّت بمساعدة الآلة وهي قيد المراجعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las traducciones que no son inglés ni español se hicieron con ayuda de máquina y están en revisión."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga salin maliban sa English at Spanish ay tinulungan ng makina at sinusuri pa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영어와 스페인어 외의 번역은 기계 번역의 도움을 받았으며 검토 중입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tłumaczenia inne niż angielskie i hiszpańskie powstały z pomocą maszyny i są w trakcie sprawdzania."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переклади, крім англійської та іспанської, зроблені за допомогою машини й перевіряються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انگریزی اور ہسپانوی کے علاوہ ترجمے مشین کی مدد سے کیے گئے ہیں اور نظرِ ثانی کے مرحلے میں ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "英语和西班牙语以外的翻译由机器辅助完成，仍在审核中。"
          }
        }
      }
    },
    "Try a wider search, a different filter, or another address.": {
      "localizations": {
        "ar": {
          "stringUnit": {
