          }
        }
      }
    },
    "Shows your confirmation code and lets you cancel": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra tu código de confirmación y permite cancelar"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje kod potwierdzenia i pozwala anulować"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示您的确认码并可取消"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض رمز التأكيد ويتيح لك الإلغاء"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita ang iyong confirmation code at hinahayaan kang magkansela"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
