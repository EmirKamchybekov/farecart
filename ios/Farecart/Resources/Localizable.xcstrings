        }
      }
    },
    "This pantry hasn't posted today's stock. Call ahead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta despensa no ha publicado su inventario de hoy. Llama antes de ir."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta jadłodajnia nie opublikowała dzisiejszych zapasów. Zadzwoń wcześniej."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该食品站尚未发布今日库存。请先致电。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ينشر هذا المخزن مخزون اليوم. اتصل مسبقًا."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa naipo-post ng pantry na ito ang stock ngayon. Tumawag muna."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس پینٹری نے آج کا اسٹاک پوسٹ نہیں کیا۔ پہلے فون کریں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей продуктовий банк ще не опублікував сьогоднішні запаси. Зателефонуйте заздалегідь."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 팬트리는 오늘 재고를 아직 게시하지 않았습니다. 미리 전화해 보세요."
          }
        }
      }
    },
    "This trip costs you": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este viaje te cuesta"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta podróż kosztuje Cię"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此行程费用"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكلفة هذه الرحلة عليك"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaga ng biyaheng ito"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سفر کا آپ کا خرچ"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця поїздка коштує вам"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 여정의 내 요금"
