    "%@ with your %@ discount (instead of %@)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ con tu descuento %2$@ (en vez de %3$@)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ze zniżką %2$@ (zamiast %3$@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 %2$@ 优惠只需 %1$@（原价 %3$@）"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ مع خصم %2$@ (بدلًا من %3$@)"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gamit ang diskuwento ng %2$@ (sa halip na %3$@)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ رعایت کے ساتھ %1$@ (%3$@ کی بجائے)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ зі знижкою %2$@ (замість %3$@)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 할인 적용 시 %1$@ (정상 요금 %3$@)"
