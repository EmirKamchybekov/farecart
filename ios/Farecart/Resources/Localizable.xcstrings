    "No slots in the next 7 days. People can still walk in during your open hours.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay horarios en los próximos 7 días. La gente puede venir sin cita en tu horario de atención."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak terminów w ciągu najbliższych 7 dni. Ludzie mogą przyjść bez rezerwacji w godzinach otwarcia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未来 7 天没有时段。开放时间内仍可直接到访。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا مواعيد خلال الأيام السبعة القادمة. ما زال بإمكان الناس الحضور دون موعد في ساعات العمل."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang slot sa susunod na 7 araw. Puwede pa ring pumasok ang mga tao sa oras na bukas kayo."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگلے 7 دنوں میں کوئی سلاٹ نہیں۔ لوگ کھلنے کے اوقات میں پھر بھی آ سکتے ہیں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає слотів на найближчі 7 днів. Люди все одно можуть прийти в години роботи."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앞으로 7일간 시간대가 없습니다. 운영 시간에는 예약 없이 방문할 수 있습니다."
          }
        }
      }
    },
