    "Based on your answers you pay the regular CTA fare.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بحسب إجاباتك، تدفع أجرة CTA العادية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Según tus respuestas, pagas la tarifa normal de la CTA."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Batay sa iyong mga sagot, regular na pamasahe ng CTA ang babayaran mo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변에 따르면 CTA 정상 요금을 내게 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z Twoich odpowiedzi wynika, że płacisz zwykłą cenę CTA."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За вашими відповідями ви платите звичайну ціну CTA."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے جوابات کے مطابق آپ CTA کا عام کرایہ ادا کرتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据您的回答，您需支付 CTA 普通票价。"
          }
        }
      }
    },
