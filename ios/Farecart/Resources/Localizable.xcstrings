    "Pick how Farecart looks. You can change it any time in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر شكل Farecart. يمكنك تغييره في أي وقت من الإعدادات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo se ve Farecart. Puedes cambiarlo cuando quieras en Ajustes."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Piliin ang itsura ng Farecart. Puwede mo itong baguhin anumang oras sa Settings."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Farecart의 화면 스타일을 고르세요. 설정에서 언제든지 바꿀 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz wygląd Farecart. Możesz go zmienić w dowolnej chwili w Ustawieniach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть, як виглядатиме Farecart. Змінити це можна будь-коли в Налаштуваннях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "منتخب کریں کہ Farecart کیسا نظر آئے۔ آپ اسے کسی بھی وقت سیٹنگز میں بدل سکتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择 Farecart 的外观。你可以随时在“设置”中更改。"
          }
        }
      }
    },
