    "Calendar access is off. Allow it in Settings → Privacy → Calendars to add visits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى التقويم متوقف. اسمح به من الإعدادات ← الخصوصية ← التقاويم لإضافة الزيارات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al calendario está desactivado. Actívalo en Ajustes → Privacidad → Calendarios para añadir visitas."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ang access sa kalendaryo. Payagan ito sa Settings → Privacy → Calendars para magdagdag ng mga pagbisita."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캘린더 접근이 꺼져 있습니다. 설정 → 개인정보 보호 → 캘린더에서 허용하면 방문을 추가할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do kalendarza jest wyłączony. Włącz go w Ustawienia → Prywatność → Kalendarze, aby dodawać wizyty."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до календаря вимкнено. Дозвольте його в Параметри → Конфіденційність → Календарі, щоб додавати візити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر تک رسائی بند ہے۔ دورے شامل کرنے کے لیے ترتیبات ← رازداری ← کیلنڈر میں اجازت دیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日历访问权限已关闭。请在“设置 → 隐私 → 日历”中允许，以添加预约。"
          }
        }
      }
    },
