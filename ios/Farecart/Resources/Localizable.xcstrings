            "state": "translated",
            "value": "آپ اسے بعد میں سیٹنگز میں بدل سکتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你之后可以在“设置”中更改。"
          }
        }
      }
    },
    "You could pay %@ instead of %@ per bus ride.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك دفع %1$@ بدلًا من %2$@ لكل رحلة حافلة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrías pagar %1$@ en vez de %2$@ por viaje en autobús."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwede kang magbayad ng %1$@ sa halip na %2$@ bawat sakay sa bus."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버스 1회당 %2$@ 대신 %1$@만 내면 됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za przejazd autobusem możesz płacić %1$@ zamiast %2$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви могли б платити %1$@ замість %2$@ за поїздку автобусом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ فی بس سواری %2$@ کی بجائے %1$@ ادا کر سکتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次乘公交您只需支付 %1$@，而不是 %2$@。"
          }
        }
      }
    },
