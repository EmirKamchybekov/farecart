          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 Farecart"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا بك في Farecart"
          }
        },
        "fil": {
          "stringUnit": {
