    "%@ away · about %lld min walk": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على بُعد %1$@ · حوالي %2$lld دقيقة مشيًا"
          }
        },
        "es": {
