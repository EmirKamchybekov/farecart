    },
    "Translations other than English and Spanish are machine-assisted and under review.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las traducciones que no son inglés ni español se hicieron con ayuda de máquina y están en revisión."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tłumaczenia inne niż angielskie i hiszpańskie powstały z pomocą maszyny i są w trakcie sprawdzania."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "英语和西班牙语以外的翻译由机器辅助完成，仍在审核中。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الترجمات غير الإنجليزية والإسبانية أُعدّت بمساعدة الآلة وهي قيد المراجعة."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang mga salin maliban sa English at Spanish ay tinulungan ng makina at sinusuri pa."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انگریزی اور ہسپانوی کے علاوہ ترجمے مشین کی مدد سے کیے گئے ہیں اور نظرِ ثانی کے مرحلے میں ہیں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переклади, крім англійської та іспанської, зроблені за допомогою машини й перевіряються."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영어와 스페인어 외의 번역은 기계 번역의 도움을 받았으며 검토 중입니다."
          }
        }
      }
    },
    "Try a wider search, a different filter, or another address.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba una búsqueda más amplia, otro filtro u otra dirección."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj szerszego wyszukiwania, innego filtru lub innego adresu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请试试扩大搜索范围、更换筛选条件或换一个地址。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب نطاق بحث أوسع، أو تصفية مختلفة، أو عنوانًا آخر."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Subukan ang mas malawak na paghahanap, ibang filter, o ibang address."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وسیع تلاش، مختلف فلٹر، یا کوئی اور پتہ آزمائیں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спробуйте ширший пошук, інший фільтр або іншу адресу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 범위를 넓히거나, 다른 필터나 다른 주소를 시도해 보세요."
          }
        }
      }
    },
