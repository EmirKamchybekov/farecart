    "No bookings yet today.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حجوزات اليوم حتى الآن."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy aún no hay reservas."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang booking ngayon."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 아직 예약이 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś nie ma jeszcze rezerwacji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні ще немає бронювань."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
