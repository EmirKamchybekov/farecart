    },
    "Find pantries, grocery stores and giveaways nearby, and ride the CTA for less.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعثر على بنوك الطعام ومتاجر البقالة وتوزيعات الطعام القريبة، واركب CTA بتكلفة أقل."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra despensas, supermercados y repartos de comida cerca, y viaja en la CTA por menos."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Maghanap ng mga pantry, grocery at libreng pamigay ng pagkain sa malapit, at sumakay sa CTA nang mas mura."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근처 푸드 팬트리, 식료품점, 무료 식품 나눔을 찾고 CTA를 더 저렴하게 이용하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź w pobliżu spiżarnie, sklepy spożywcze i rozdawnictwa żywności i jeździj CTA taniej."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знаходьте поруч продовольчі банки, продуктові магазини й роздачі їжі та їздьте CTA дешевше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قریبی پینٹریز، گروسری اسٹورز اور مفت کھانے کی تقسیم تلاش کریں، اور CTA پر کم کرائے میں سفر کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找附近的食物银行、杂货店和免费食物发放点，并以更低票价乘坐 CTA。"
          }
        }
      }
    },
