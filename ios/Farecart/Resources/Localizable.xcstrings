    "Email %@ if a place has closed, moved or changed its hours.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راسل %@ إذا أُغلق مكان أو انتقل أو تغيّرت ساعات عمله."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe a %@ si un lugar cerró, se mudó o cambió su horario."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-email sa %@ kung may lugar na nagsara, lumipat, o nagbago ng oras."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소가 문을 닫았거나, 이전했거나, 영업시간이 바뀌었다면 %@로 이메일을 보내 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz na %@, jeśli jakieś miejsce zostało zamknięte, przeniesione lub zmieniło godziny."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Напишіть на %@, якщо місце зачинилося, переїхало або змінило години роботи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اگر کوئی جگہ بند ہو گئی، منتقل ہو گئی یا اوقات بدل گئے ہیں تو %@ پر ای میل کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果某个地点已关闭、搬迁或更改了营业时间，请发邮件至 %@。"
          }
        }
      }
    },
