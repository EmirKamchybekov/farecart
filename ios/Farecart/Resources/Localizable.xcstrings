    "Location access is off. Allow it in Settings, or type an address instead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la ubicación está desactivado. Actívalo en Configuración o escribe una dirección."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do lokalizacji jest wyłączony. Włącz go w Ustawieniach lub wpisz adres."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置访问已关闭。请在“设置”中允许，或改为输入地址。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الموقع متوقف. اسمح به في الإعدادات، أو اكتب عنوانًا بدلًا من ذلك."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ang access sa lokasyon. Payagan ito sa Settings, o mag-type na lang ng address."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام تک رسائی بند ہے۔ ترتیبات میں اجازت دیں، یا اس کی بجائے پتہ لکھیں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до геолокації вимкнено. Дозвольте його в Налаштуваннях або введіть адресу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치 접근이 꺼져 있어요. 설정에서 허용하거나 주소를 입력하세요."
          }
        }
      }
    },
