    "A bus ride costs %@. If that changes, update your answers in Discounts.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رحلة الحافلة تكلف %@. إذا تغيّر ذلك، حدّث إجاباتك في الخصومات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un viaje en autobús cuesta %@. Si eso cambia, actualiza tus respuestas en Descuentos."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang isang sakay sa bus ay %@. Kung magbago iyon, i-update ang mga sagot mo sa Mga Diskuwento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버스 1회 요금은 %@입니다. 상황이 바뀌면 할인 탭에서 답변을 업데이트하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejazd autobusem kosztuje %@. Jeśli coś się zmieni, zaktualizuj odpowiedzi w Zniżkach."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поїздка автобусом коштує %@. Якщо щось зміниться, оновіть відповіді у «Знижках»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بس کی ایک سواری %@ کی ہے۔ اگر یہ بدلے تو رعایتیں میں اپنے جوابات اپ ڈیٹ کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次公交车费为 %@。如果情况有变，请在“优惠”中更新您的回答。"
          }
        }
      }
    },
    "A photo ID is required here. SNAP is not.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب هنا هوية بصورة. SNAP غير مطلوب."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí se pide identificación con foto. SNAP no."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan dito ng photo ID. Hindi kailangan ang SNAP."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이곳은 사진이 있는 신분증이 필요합니다. SNAP은 필요 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj wymagany jest dokument ze zdjęciem. SNAP nie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут потрібне посвідчення з фото. SNAP не потрібен."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں تصویر والی شناخت درکار ہے۔ SNAP نہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处需要带照片的身份证件，无需 SNAP。"
          }
        }
      }
    },
