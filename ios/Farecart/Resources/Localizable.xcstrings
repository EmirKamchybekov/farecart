          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося ввійти. Перевірте з'єднання і спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی سائن ان نہیں ہو سکا۔ اپنا کنکشن چیک کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
