    },
    "Showing sample data: the app is missing its Supabase settings. %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrando datos de ejemplo: a la app le falta la configuración de Supabase. %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane przykładowe: aplikacji brakuje ustawień Supabase. %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示示例数据：应用缺少 Supabase 设置。%@"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض بيانات تجريبية: التطبيق يفتقد إعدادات Supabase. %@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita ang sample data: kulang ang app ng Supabase settings. %@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نمونہ ڈیٹا دکھایا جا رہا ہے: ایپ میں Supabase ترتیبات موجود نہیں۔ %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зразкові дані: у застосунку немає налаштувань Supabase. %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플 데이터 표시 중: 앱에 Supabase 설정이 없습니다. %@"
          }
        }
      }
    },
    "Shows bus and train directions with your fare": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra indicaciones de autobús y tren con tu tarifa"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje trasę autobusem i pociągiem z Twoją ceną"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示公交和列车路线及您的票价"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض اتجاهات الحافلات والقطارات مع أجرتك"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapakita ang direksyon ng bus at tren kasama ang pamasahe mo"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے کرائے کے ساتھ بس اور ٹرین کے راستے دکھاتا ہے"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує маршрут автобусом і поїздом з вашою ціною"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 요금과 함께 버스, 열차 길찾기를 보여줍니다"
          }
        }
      }
    },
    "Sign in needs the app's Supabase settings, which are missing in this build.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para iniciar sesión hace falta la configuración de Supabase, que falta en esta versión."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie wymaga ustawień Supabase, których brakuje w tej wersji aplikacji."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录需要应用的 Supabase 设置，而此版本缺少该设置。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج تسجيل الدخول إلى إعدادات Supabase الخاصة بالتطبيق، وهي غير موجودة في هذا الإصدار."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng pag-sign in ang Supabase settings ng app, na wala sa build na ito."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن ان کے لیے ایپ کی Supabase ترتیبات درکار ہیں، جو اس بلڈ میں موجود نہیں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для входу потрібні налаштування Supabase, яких немає в цій збірці."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하려면 앱의 Supabase 설정이 필요한데, 이 빌드에는 없습니다."
          }
        }
      }
    },
    "Sign in to keep your discount answers, language and theme if you change phones. Everything works without an account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para guardar tus respuestas de descuentos, idioma y tema si cambias de teléfono. Todo funciona sin cuenta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się, aby zachować odpowiedzi o zniżkach, język i motyw przy zmianie telefonu. Wszystko działa też bez konta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录后，换手机时也能保留您的优惠回答、语言和主题。不登录也能正常使用全部功能。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول للاحتفاظ بإجابات الخصومات واللغة والمظهر إذا غيّرت هاتفك. كل شيء يعمل بدون حساب."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in para mapanatili ang mga sagot mo sa diskuwento, wika at tema kung magpalit ka ng telepono. Gumagana ang lahat kahit walang account."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون بدلنے پر رعایت کے جوابات، زبان اور تھیم محفوظ رکھنے کے لیے سائن ان کریں۔ اکاؤنٹ کے بغیر بھی سب کچھ کام کرتا ہے۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть, щоб зберегти відповіді про знижки, мову та тему, якщо зміните телефон. Усе працює й без облікового запису."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하면 휴대폰을 바꿔도 할인 답변, 언어, 화면 모드가 유지됩니다. 계정 없이도 모든 기능을 쓸 수 있어요."
          }
        }
      }
    },
    "Sign in with Apple did not finish. Please try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se completó el inicio de sesión con Apple. Inténtalo de nuevo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie przez Apple nie zostało ukończone. Spróbuj ponownie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Apple 登录未完成。请重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل تسجيل الدخول بـ Apple. يُرجى المحاولة مرة أخرى."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi natapos ang Sign in with Apple. Pakisubukan ulit."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple سے سائن ان مکمل نہیں ہوا۔ براہ کرم دوبارہ کوشش کریں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід через Apple не завершено. Спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple로 로그인이 완료되지 않았어요. 다시 시도해 주세요."
          }
        }
      }
    },
    "Sign in with Apple is not available on this device right now. You can keep using Farecart without an account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión con Apple no está disponible en este dispositivo ahora. Puedes seguir usando Farecart sin cuenta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie przez Apple jest teraz niedostępne na tym urządzeniu. Możesz dalej używać Farecart bez konta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备目前无法使用“通过 Apple 登录”。您可以继续在没有账户的情况下使用 Farecart。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول بـ Apple غير متاح على هذا الجهاز الآن. يمكنك متابعة استخدام Farecart بدون حساب."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi available ang Sign in with Apple sa device na ito ngayon. Puwede mong patuloy na gamitin ang Farecart nang walang account."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple سے سائن ان ابھی اس ڈیوائس پر دستیاب نہیں۔ آپ اکاؤنٹ کے بغیر Farecart استعمال کرتے رہ سکتے ہیں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід через Apple зараз недоступний на цьому пристрої. Ви можете й далі користуватися Farecart без облікового запису."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 이 기기에서는 Apple로 로그인을 사용할 수 없어요. 계정 없이 Farecart를 계속 사용할 수 있습니다."
          }
        }
      }
    },
    "Sign in with Apple or Google to save your answers, language and theme if you change phones. This is optional.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con Apple o Google para guardar tus respuestas, idioma y tema si cambias de teléfono. Es opcional."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się przez Apple lub Google, aby zapisać odpowiedzi, język i motyw na wypadek zmiany telefonu. To nieobowiązkowe."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Apple 或 Google 登录，以便换手机时保留您的回答、语言和主题。这是可选的。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول بـ Apple أو Google لحفظ إجاباتك ولغتك ومظهرك إذا غيّرت هاتفك. هذا اختياري."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in gamit ang Apple o Google para ma-save ang mga sagot, wika at tema mo kung magpalit ka ng telepono. Opsyonal ito."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فون بدلنے پر اپنے جوابات، زبان اور تھیم محفوظ رکھنے کے لیے Apple یا Google سے سائن ان کریں۔ یہ اختیاری ہے۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увійдіть через Apple або Google, щоб зберегти відповіді, мову та тему на випадок зміни телефону. Це необов'язково."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 또는 Google로 로그인하면 휴대폰을 바꿔도 답변, 언어, 화면 모드가 저장됩니다. 선택 사항입니다."
          }
        }
      }
    },
