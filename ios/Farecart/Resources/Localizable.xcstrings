    "Only people with a code can change a pantry's listing. Nothing you post is tied to your name.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط من لديه رمز يمكنه تغيير بيانات المخزن. لا يُربط ما تنشره باسمك."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quien tiene un código puede cambiar la ficha de una despensa. Nada de lo que publiques se vincula a tu nombre."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanging mga may code ang puwedeng magbago sa listing ng pantry. Walang ipo-post mo na nakatali sa iyong pangalan."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 있는 사람만 팬트리 정보를 변경할 수 있습니다. 게시한 내용은 이름과 연결되지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko osoby z kodem mogą zmieniać wpis jadłodajni. Nic, co publikujesz, nie jest powiązane z Twoim nazwiskiem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише люди з кодом можуть змінювати дані продуктового банку. Нічого з опублікованого не прив’язане до вашого імені."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف کوڈ رکھنے والے لوگ پینٹری کی معلومات بدل سکتے ہیں۔ آپ جو کچھ پوسٹ کرتے ہیں وہ آپ کے نام سے منسلک نہیں ہوتا۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有持有代码的人才能修改食品站信息。您发布的内容不会与您的姓名关联。"
          }
        }
      }
    },
