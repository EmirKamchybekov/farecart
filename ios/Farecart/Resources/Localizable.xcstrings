    },
    "SNAP and a photo ID are required here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب هنا SNAP وهوية بصورة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí se piden SNAP e identificación con foto."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan dito ng SNAP at photo ID."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이곳은 SNAP과 사진이 있는 신분증이 필요합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj wymagane są SNAP i dokument ze zdjęciem."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут потрібні SNAP і посвідчення з фото."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں SNAP اور تصویر والی شناخت درکار ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处需要 SNAP 和带照片的身份证件。"
          }
        }
      }
    },
    "SNAP is also called food stamps or the Link card.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسمّى SNAP أيضًا كوبونات الطعام أو بطاقة Link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SNAP también se conoce como estampillas de comida o la tarjeta Link."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinatawag din ang SNAP na food stamps o Link card."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SNAP은 푸드 스탬프 또는 Link 카드라고도 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SNAP to inaczej kartki na żywność (food stamps) albo karta Link."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SNAP також називають продовольчими талонами (food stamps) або карткою Link."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "SNAP کو فوڈ اسٹیمپس یا Link کارڈ بھی کہتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SNAP 也叫食品券或 Link 卡。"
          }
        }
      }
    },
    "SNAP is required here. Most pantries don't ask for ID.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "SNAP مطلوب هنا. معظم المخازن لا تطلب هوية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí se pide SNAP. La mayoría de las despensas no piden identificación."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan dito ng SNAP. Karamihan sa mga pantry ay hindi humihingi ng ID."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이곳은 SNAP이 필요합니다. 대부분의 팬트리는 신분증을 요구하지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj wymagany jest SNAP. Większość jadłodajni nie prosi o dokument."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тут потрібен SNAP. Більшість продуктових банків не просять посвідчення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہاں SNAP درکار ہے۔ زیادہ تر پینٹریز شناخت نہیں مانگتیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处需要 SNAP。大多数食品站不要求身份证件。"
          }
        }
      }
    },
