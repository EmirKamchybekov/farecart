    "Check your email. We sent a link to %@. Open it on this phone to finish.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من بريدك الإلكتروني. أرسلنا رابطًا إلى %@. افتحه على هذا الهاتف لإكمال العملية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa tu correo. Enviamos un enlace a %@. Ábrelo en este teléfono para terminar."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingnan ang iyong email. Nagpadala kami ng link sa %@. Buksan ito sa teleponong ito para matapos."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일을 확인하세요. %@(으)로 링크를 보냈습니다. 이 휴대폰에서 열어 마무리하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź pocztę. Wysłaliśmy link na adres %@. Otwórz go na tym telefonie, aby dokończyć."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте пошту. Ми надіслали посилання на %@. Відкрийте його на цьому телефоні, щоб завершити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی ای میل دیکھیں۔ ہم نے %@ پر ایک لنک بھیجا ہے۔ مکمل کرنے کے لیے اسے اسی فون پر کھولیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请查看邮箱。我们已向 %@ 发送了一个链接。请在这部手机上打开它以完成操作。"
          }
        }
      }
    },
