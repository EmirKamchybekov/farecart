          }
        }
      }
    },
    "No bookings yet today.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy aún no hay reservas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś nie ma jeszcze rezerwacji."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天还没有预约。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا حجوزات اليوم حتى الآن."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang booking ngayon."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج ابھی تک کوئی بکنگ نہیں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сьогодні ще немає бронювань."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 아직 예약이 없습니다."
          }
        }
      }
    },
    "No match for that address. Try adding the street number or ZIP code.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay resultados para esa dirección. Prueba agregando el número de la calle o el código postal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono tego adresu. Spróbuj dodać numer domu lub kod pocztowy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到该地址。请试着加上门牌号或邮编。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد نتيجة لهذا العنوان. جرّب إضافة رقم الشارع أو الرمز البريدي."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang tugma sa address na iyon. Subukang idagdag ang numero ng kalye o ZIP code."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس پتے کا کوئی نتیجہ نہیں ملا۔ گلی کا نمبر یا ZIP کوڈ شامل کر کے دیکھیں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Адресу не знайдено. Спробуйте додати номер будинку або індекс."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 주소와 일치하는 결과가 없어요. 번지수나 우편번호를 추가해 보세요."
          }
        }
      }
    },
    "No problem. Open the trip in a maps app instead; it shows the same buses and trains.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pasa nada. Abre el viaje en una app de mapas; muestra los mismos autobuses y trenes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie szkodzi. Otwórz podróż w aplikacji map; pokaże te same autobusy i pociągi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没关系。请改在地图应用中打开此行程，它会显示相同的公交和列车。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا بأس. افتح الرحلة في تطبيق خرائط؛ فهو يعرض نفس الحافلات والقطارات."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayos lang. Buksan na lang ang biyahe sa maps app; ipapakita nito ang parehong bus at tren."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی بات نہیں۔ سفر نقشے کی ایپ میں کھولیں؛ وہ یہی بسیں اور ٹرینیں دکھاتی ہے۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого страшного. Відкрийте поїздку в застосунку карт — там ті самі автобуси й поїзди."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "괜찮아요. 대신 지도 앱에서 여정을 열어 보세요. 같은 버스와 열차가 표시됩니다."
          }
        }
      }
    },
