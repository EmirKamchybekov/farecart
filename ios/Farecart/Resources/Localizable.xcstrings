    "No CTA route found for this trip right now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró una ruta de la CTA para este viaje ahora mismo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono teraz trasy CTA dla tej podróży."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前未找到此行程的 CTA 路线。"
