    },
    "Could not find your location right now. Try typing an address.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos encontrar tu ubicación ahora. Intenta escribir una dirección."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się teraz ustalić Twojej lokalizacji. Spróbuj wpisać adres."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在无法获取您的位置。请试着输入地址。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديد موقعك الآن. جرّب كتابة عنوان."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mahanap ang lokasyon mo ngayon. Subukang mag-type ng address."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی آپ کا مقام معلوم نہیں ہو سکا۔ پتہ لکھ کر دیکھیں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося визначити ваше місцеперебування. Спробуйте ввести адресу."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 위치를 찾을 수 없어요. 주소를 입력해 보세요."
          }
        }
      }
    },
    "Could not load places. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los lugares. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać miejsc. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载地点。请检查网络连接后重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل الأماكن. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-load ang mga lugar. Suriin ang koneksyon mo at subukan ulit."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جگہیں لوڈ نہیں ہو سکیں۔ اپنا کنکشن چیک کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити місця. Перевірте з'єднання і спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소를 불러오지 못했어요. 연결을 확인하고 다시 시도하세요."
          }
        }
      }
    },
    "Could not look up that address. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo buscar esa dirección. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się znaleźć tego adresu. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法查找该地址。请检查网络连接后重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر البحث عن هذا العنوان. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mahanap ang address na iyon. Suriin ang koneksyon mo at subukan ulit."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ پتہ تلاش نہیں ہو سکا۔ اپنا کنکشن چیک کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося знайти цю адресу. Перевірте з'єднання і спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 주소를 찾지 못했어요. 연결을 확인하고 다시 시도하세요."
          }
        }
      }
    },
    "Could not reach the pantry service. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con el servicio de despensas. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć z usługą jadłodajni. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到食品站服务。请检查网络后重试。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى خدمة المخازن. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi maabot ang serbisyo ng pantry. Suriin ang iyong koneksyon at subukang muli."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پینٹری سروس تک رسائی نہیں ہو سکی۔ اپنا کنکشن چیک کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося зв’язатися зі службою продуктових банків. Перевірте з’єднання і спробуйте ще раз."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팬트리 서비스에 연결할 수 없습니다. 연결 상태를 확인하고 다시 시도하세요."
          }
        }
      }
    },
    "Could not sign in right now. Check your connection and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
