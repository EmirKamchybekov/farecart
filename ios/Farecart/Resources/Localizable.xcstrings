            "state": "translated",
            "value": "Apple Maps. Las indicaciones se abren en Apple Maps o Google Maps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Maps. Trasy otwierają się w Apple Maps lub Google Maps."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 地图。路线会在 Apple 地图或 Google 地图中打开。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خرائط Apple. تُفتح الاتجاهات في خرائط Apple أو خرائط Google."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
