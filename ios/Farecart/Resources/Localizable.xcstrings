    "Finding your location is taking too long. Try again or type an address.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديد موقعك يستغرق وقتًا طويلًا. حاول مرة أخرى أو اكتب عنوانًا."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrar tu ubicación está tardando demasiado. Inténtalo de nuevo o escribe una dirección."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong matagal hanapin ang lokasyon mo. Subukan ulit o mag-type ng address."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위치를 찾는 데 너무 오래 걸려요. 다시 시도하거나 주소를 입력하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustalanie lokalizacji trwa zbyt długo. Spróbuj ponownie lub wpisz adres."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визначення місцеперебування триває надто довго. Спробуйте ще раз або введіть адресу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا مقام معلوم کرنے میں بہت دیر لگ رہی ہے۔ دوبارہ کوشش کریں یا پتہ لکھیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "获取您的位置时间过长。请重试或输入地址。"
          }
        }
      }
    },
