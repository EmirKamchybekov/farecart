    "Sign in needs the app's Supabase settings, which are missing in this build.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج تسجيل الدخول إلى إعدادات Supabase الخاصة بالتطبيق، وهي غير موجودة في هذا الإصدار."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para iniciar sesión hace falta la configuración de Supabase, que falta en esta versión."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng pag-sign in ang Supabase settings ng app, na wala sa build na ito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인하려면 앱의 Supabase 설정이 필요한데, 이 빌드에는 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie wymaga ustawień Supabase, których brakuje w tej wersji aplikacji."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для входу потрібні налаштування Supabase, яких немає в цій збірці."
          }
        },
        "ur": {
