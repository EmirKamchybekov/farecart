    "New accounts are turned off right now. You can keep using Farecart as a guest.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء حسابات جديدة متوقف حاليًا. يمكنك مواصلة استخدام Farecart كضيف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no se pueden crear cuentas nuevas. Puedes seguir usando Farecart como invitado."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-off ngayon ang paggawa ng bagong account. Puwede mong ituloy ang paggamit ng Farecart bilang bisita."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 새 계정을 만들 수 없습니다. 게스트로 Farecart를 계속 사용할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzenie nowych kont jest teraz wyłączone. Możesz dalej korzystać z Farecart jako gość."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створення нових облікових записів зараз вимкнено. Ви можете далі користуватися Farecart як гість."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئے اکاؤنٹس فی الحال بند ہیں۔ آپ مہمان کے طور پر Farecart استعمال کرتے رہ سکتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前暂停创建新账户。你可以继续以访客身份使用 Farecart。"
          }
        }
      }
    },
