    "Could not add the visit to your calendar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت إضافة الزيارة إلى التقويم."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo añadir la visita a tu calendario."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi maidagdag ang pagbisita sa iyong kalendaryo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방문을 캘린더에 추가하지 못했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się dodać wizyty do kalendarza."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося додати візит до календаря."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دورہ آپ کے کیلنڈر میں شامل نہیں ہو سکا۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法将预约添加到您的日历。"
          }
        }
      }
    },
    "Could not delete your account right now. Check your connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حذف حسابك الآن. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo eliminar tu cuenta ahora. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-delete ang iyong account ngayon. Tingnan ang iyong koneksyon at subukang muli."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 계정을 삭제할 수 없습니다. 연결을 확인하고 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się teraz usunąć konta. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз не вдалося видалити обліковий запис. Перевірте з'єднання і спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی آپ کا اکاؤنٹ حذف نہیں ہو سکا۔ اپنا کنکشن چیک کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法删除你的账户。请检查网络连接后重试。"
          }
        }
      }
    },
    "Could not find your location right now. Try typing an address.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحديد موقعك الآن. جرّب كتابة عنوان."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos encontrar tu ubicación ahora. Intenta escribir una dirección."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mahanap ang lokasyon mo ngayon. Subukang mag-type ng address."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 위치를 찾을 수 없어요. 주소를 입력해 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się teraz ustalić Twojej lokalizacji. Spróbuj wpisać adres."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося визначити ваше місцеперебування. Спробуйте ввести адресу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی آپ کا مقام معلوم نہیں ہو سکا۔ پتہ لکھ کر دیکھیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在无法获取您的位置。请试着输入地址。"
          }
        }
      }
    },
    "Could not load places. Check your connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تحميل الأماكن. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron cargar los lugares. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ma-load ang mga lugar. Suriin ang koneksyon mo at subukan ulit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장소를 불러오지 못했어요. 연결을 확인하고 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się wczytać miejsc. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити місця. Перевірте з'єднання і спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جگہیں لوڈ نہیں ہو سکیں۔ اپنا کنکشن چیک کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载地点。请检查网络连接后重试。"
          }
        }
      }
    },
    "Could not look up that address. Check your connection and try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر البحث عن هذا العنوان. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo buscar esa dirección. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mahanap ang address na iyon. Suriin ang koneksyon mo at subukan ulit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그 주소를 찾지 못했어요. 연결을 확인하고 다시 시도하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
