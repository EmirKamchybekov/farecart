    "%@, %@. Your spot goes back to the pantry.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، %@. سيعود مكانك إلى المخزن."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@. Tu lugar vuelve a la despensa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@. Babalik sa pantry ang iyong puwesto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@. 예약 자리는 푸드 팬트리로 반환됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@. Twoje miejsce wraca do jadłodajni."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@. Ваше місце повернеться до продуктового банку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@، %@۔ آپ کی جگہ پینٹری کو واپس چلی جائے گی۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，%@。您的名额将退回给食品站。"
          }
        }
      }
    },
