    "Your account, name and email are removed from Farecart.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم إزالة حسابك واسمك وبريدك الإلكتروني من Farecart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta, tu nombre y tu correo se eliminan de Farecart."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Aalisin sa Farecart ang iyong account, pangalan at email."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정, 이름, 이메일이 Farecart에서 삭제됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje konto, imię i e-mail zostaną usunięte z Farecart."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш обліковий запис, ім'я та адресу буде видалено з Farecart."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا اکاؤنٹ، نام اور ای میل Farecart سے ہٹا دیے جائیں گے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户、姓名和邮箱将从 Farecart 中删除。"
          }
        }
      }
    },
    "Your answers, language and theme stay on this phone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجاباتك ولغتك ومظهرك تبقى على هذا الهاتف."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus respuestas, idioma y tema se quedan en este teléfono."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nananatili sa teleponong ito ang mga sagot, wika at tema mo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변, 언어, 화면 모드는 이 휴대폰에 그대로 남습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje odpowiedzi, język i motyw zostają na tym telefonie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші відповіді, мова й тема залишаються на цьому телефоні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے جوابات، زبان اور تھیم اسی فون پر رہتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的回答、语言和主题会保留在此手机上。"
          }
        }
      }
    },
    "Your fare": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أجرتك"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tarifa"
          }
        },
        "fil": {
