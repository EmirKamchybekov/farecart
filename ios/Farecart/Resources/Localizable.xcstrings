          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے واپس نہیں کیا جا سکتا۔ آپ بعد میں نیا اکاؤنٹ بنا سکتے ہیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。你以后可以重新创建账户。"
          }
        }
