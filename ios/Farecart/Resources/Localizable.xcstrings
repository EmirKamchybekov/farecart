    "Hours not listed. Call ahead if you can.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Horario no disponible. Llama antes si puedes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak godzin otwarcia. Jeśli możesz, zadzwoń wcześniej."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未列出营业时间。如果可以，请先致电。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ساعات العمل غير مدرجة. اتصل مسبقًا إن أمكن."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nakalistang oras. Tumawag muna kung kaya mo."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوقات درج نہیں ہیں۔ ممکن ہو تو پہلے کال کر لیں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Години роботи не вказані. Якщо можете, зателефонуйте заздалегідь."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영업시간이 없습니다. 가능하면 미리 전화해 보세요."
          }
        }
      }
    },
