          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录或创建免费账户即可使用 Farecart。"
          }
        }
      }
    },
    "Sign in with Apple did not finish. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يكتمل تسجيل الدخول بـ Apple. يُرجى المحاولة مرة أخرى."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se completó el inicio de sesión con Apple. Inténtalo de nuevo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi natapos ang Sign in with Apple. Pakisubukan ulit."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple로 로그인이 완료되지 않았어요. 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie przez Apple nie zostało ukończone. Spróbuj ponownie."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід через Apple не завершено. Спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple سے سائن ان مکمل نہیں ہوا۔ براہ کرم دوبارہ کوشش کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Apple 登录未完成。请重试。"
          }
        }
      }
    },
    "Sign in with Apple is not available on this device right now. Use Google or email instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول باستخدام Apple غير متاح على هذا الجهاز الآن. استخدم Google أو البريد الإلكتروني."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión con Apple no está disponible ahora en este dispositivo. Usa Google o tu correo."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi available ngayon ang Sign in with Apple sa device na ito. Gamitin ang Google o email."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 이 기기에서는 Apple로 로그인할 수 없어요. Google이나 이메일을 사용하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie przez Apple jest teraz niedostępne na tym urządzeniu. Użyj Google lub e-maila."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід через Apple зараз недоступний на цьому пристрої. Скористайтеся Google або електронною поштою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ڈیوائس پر ابھی Apple سے سائن ان دستیاب نہیں۔ Google یا ای میل استعمال کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备目前无法使用 Apple 登录。请改用 Google 或电子邮件。"
          }
        }
      }
    },
    "Sign in with Apple is not available on this device right now. You can keep using Farecart without an account.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول بـ Apple غير متاح على هذا الجهاز الآن. يمكنك متابعة استخدام Farecart بدون حساب."
          }
