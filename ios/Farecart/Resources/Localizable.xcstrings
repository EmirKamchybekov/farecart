    "Find food near you": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعثر على طعام بالقرب منك"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra comida cerca de ti"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Humanap ng pagkain malapit sa iyo"
          }
        },
        "ko": {
