            "state": "translated",
            "value": "У вас уже є візит на цей час."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا اس وقت کے لیے پہلے ہی دورہ بک ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已预约该时段。"
          }
        }
      }
    },
    "You can change this later in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تغيير ذلك لاحقًا من الإعدادات."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiarlo después en Ajustes."
