          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 지도. 길찾기는 Apple 지도 또는 Google 지도에서 열립니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
