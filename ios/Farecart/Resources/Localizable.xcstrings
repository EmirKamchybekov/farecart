    "Not yet verified by our team. Hours and rules may have changed. Call ahead if you can.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no verificado por nuestro equipo. El horario y las reglas pueden haber cambiado. Llama antes si puedes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze niezweryfikowane przez nasz zespół. Godziny i zasady mogły się zmienić. Jeśli możesz, zadzwoń wcześniej."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们的团队尚未核实。营业时间和规定可能已更改。如果可以，请先致电。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتحقق فريقنا منه بعد. قد تكون ساعات العمل والقواعد تغيّرت. اتصل مسبقًا إن أمكن."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa na-verify ng aming team. Maaaring nagbago ang oras at mga patakaran. Tumawag muna kung kaya mo."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہماری ٹیم نے ابھی تصدیق نہیں کی۔ اوقات اور اصول بدل چکے ہو سکتے ہیں۔ ممکن ہو تو پہلے کال کر لیں۔"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ще не перевірено нашою командою. Години та правила могли змінитися. Якщо можете, зателефонуйте заздалегідь."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 저희 팀이 확인하지 않았습니다. 영업시간과 규정이 바뀌었을 수 있어요. 가능하면 미리 전화해 보세요."
          }
        }
      }
    },
