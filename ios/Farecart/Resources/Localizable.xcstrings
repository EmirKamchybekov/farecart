    "More people are booked than that. Raise the capacity.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد المحجوزين أكبر من ذلك. ارفع السعة."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay más personas reservadas que eso. Aumenta la capacidad."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas marami ang naka-book kaysa riyan. Taasan ang kapasidad."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그보다 많은 인원이 예약되어 있습니다. 정원을 늘리세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarezerwowano więcej osób. Zwiększ liczbę miejsc."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заброньовано більше людей. Збільште місткість."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس سے زیادہ لوگ بک ہیں۔ گنجائش بڑھائیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已预约人数超过此数值。请提高容量。"
          }
        }
      }
    },
    "Most pantries don't require SNAP or ID.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معظم المخازن لا تتطلب SNAP أو هوية."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría de las despensas no piden SNAP ni identificación."
