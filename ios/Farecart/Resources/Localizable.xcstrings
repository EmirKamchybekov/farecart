            "state": "translated",
            "value": "登录需要应用的 Supabase 设置，而此版本缺少该设置。"
          }
        }
      }
    },
    "Sign in or create a free account to use Farecart.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول أو أنشئ حسابًا مجانيًا لاستخدام Farecart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión o crea una cuenta gratis para usar Farecart."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in o gumawa ng libreng account para magamit ang Farecart."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Farecart를 사용하려면 로그인하거나 무료 계정을 만드세요."
          }
        },
        "pl": {
