    "Confirm your email first: open the link we sent you, then sign in.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد بريدك الإلكتروني أولًا: افتح الرابط الذي أرسلناه إليك، ثم سجّل الدخول."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero confirma tu correo: abre el enlace que te enviamos y luego inicia sesión."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpirmahin muna ang iyong email: buksan ang link na ipinadala namin, saka mag-sign in."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 이메일을 인증하세요. 보내 드린 링크를 연 다음 로그인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw potwierdź e-mail: otwórz wysłany link, a potem się zaloguj."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу підтвердьте пошту: відкрийте надіслане посилання, а потім увійдіть."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے اپنی ای میل کی تصدیق کریں: ہمارا بھیجا ہوا لنک کھولیں، پھر سائن ان کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先确认你的邮箱：打开我们发送的链接，然后再登录。"
          }
        }
      }
    },
